# Monorepo root ignore. web/ (the Bun+Docker app) and wails/ (the desktop app)
# each have their own build outputs too.

# Dependencies (matches any level: web/node_modules, wails/frontend/node_modules)
node_modules

# App-written backups (docker bind mount / dev)
backups/
server/backups/

# Wails desktop app build artifacts
wails/build/bin/
wails/build/sidecar/
wails/frontend/dist/
wails/frontend/wailsjs/
